
module decode7 (
    input logic [3:0] num,  // four bits number
    output logic [7:0] leds // activation of 7 segment display
);

// combinational logic
// match the numbers (0-9) with LEDS to display


    always_comb begin
        case (num)
							4'd0: leds = 8'b00111111;
							4'd1: leds = 8'b00000110; 
							4'd2: leds = 8'b01011011; 
							4'd3: leds = 8'b01001111; 
							4'd4: leds = 8'b01100110; 
							4'd5: leds = 8'b01101101; 
							4'd6: leds = 8'b01111101; 
							4'd7: leds = 8'b00000111; 
							4'd8: leds = 8'b01111111; 
							4'd9: leds = 8'b01101111;

            default: leds = 8'b11111111; 
        endcase
    end
endmodule
