//Lab3 
//This module converts the the rotation into desired frequency values

module enc2freq(
    input logic cw, ccw,       // Clockwise & Counterclockwise pulses from encoder
    output logic [31:0] freq,  // Output frequency
    input logic reset_n, clk   // Reset and clock
);

    logic [2:0] note_index;
    logic [31:0] notes [0:7];

    // Define the notes
    always_comb begin
        notes[0] = 262; //0x106
        notes[1] = 295; //0x127
        notes[2] = 328; //0x148
        notes[3] = 349; //0x15D
        notes[4] = 393; //0x189
        notes[5] = 437; //0x1B5
        notes[6] = 491; //0x1EB
        notes[7] = 524; //0x20C
    end
		// for pulse 
	 logic  pulse_count1;
	 logic  pulse_count2;
	 logic [2:0] pulse_count10;
	 logic [2:0] pulse_count20;
	 
	 always_ff @(posedge clk) begin
        
        if (cw) begin
        
				pulse_count10 <= pulse_count10 + 1;	 
				 
            if (pulse_count10 == 3) begin 
						pulse_count1 <= 1; 
						pulse_count10 <= 0; 
						 		
            end
				else pulse_count1 <= 0; 
					
				
        end 
		  
		  else if (ccw) begin  
        
				pulse_count20 <= pulse_count20 + 1;
				 
            if (pulse_count20 == 3) 
				begin     
                pulse_count2 <= 1; 
					 pulse_count20 <= 0;
 					
			   end
				
				else pulse_count2 <= 0;			
				 
			end	
	end		
	 
	  // Edge detection for `pulsecount1` and `pulsecount2`
    logic pulse_count1_last, pulse_count2_last;
    
    always_ff @(posedge clk) begin
        pulse_count1_last <= pulse_count1;
        pulse_count2_last <= pulse_count2;
    end
	 

    // Create a cycle for desired frequencies based on rotation
	 
    always_ff @(posedge clk or negedge reset_n) begin
        if (!reset_n)
            note_index <= 0;
        else if (pulse_count1 && !pulse_count1_last && note_index < 7) 
            note_index <= note_index + 1;
        else if (pulse_count2 && !pulse_count2_last && note_index > 0) 
            note_index <= note_index - 1;
    end

    // Assign correct frequency as an ouput variable
    assign freq = notes[note_index];

endmodule


